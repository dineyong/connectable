{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connectable.example/schemas/user-question-v2.schema.json",
  "title": "Connectable user question corpus v2 — authoritative",
  "description": "Adopted user-observation corpus. Official specifications remain in a separate dataset. Validate cross-references and evidence gates with validate_question_corpus_v2.py.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "2"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^UQ-[0-9]{4,}$"
    },
    "case_classification": {
      "type": "object",
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "QUESTION",
              "TROUBLESHOOTING_REPORT",
              "PRE_PURCHASE_QUESTION",
              "LONG_TERM_REPORT",
              "UNKNOWN"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "long_term_basis": {
          "$ref": "#/$defs/long_term_basis"
        }
      },
      "required": [
        "types",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "problem_type": {
      "type": "string",
      "description": "주요 문제 분류",
      "examples": [
        "NO_SIGNAL"
      ],
      "enum": [
        "NO_SIGNAL",
        "RESOLUTION",
        "REFRESH_RATE",
        "MULTI_DISPLAY",
        "FLICKER",
        "PD_CHARGING",
        "HDR",
        "OTHER",
        "UNKNOWN"
      ]
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/port"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "configurations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/configuration"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "goal": {
      "$ref": "#/$defs/goal"
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "product_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product_link"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "migration": {
      "$ref": "#/$defs/migration"
    },
    "configuration_conclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/configuration_conclusion"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "case_classification",
    "source",
    "problem_type",
    "environment",
    "evidence",
    "nodes",
    "ports",
    "configurations",
    "goal",
    "attempts",
    "observations",
    "outcome",
    "product_links",
    "review"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "ORIGINAL_POST",
            "AUTHOR_COMMENT",
            "EDITED_POST",
            "OTHER_COMMENT"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "CASE_AUTHOR",
            "OTHER",
            "UNKNOWN"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "checked_at": {
          "type": "string",
          "minLength": 1,
          "format": "date"
        },
        "published_at": {
          "type": "string",
          "minLength": 1,
          "format": "date"
        },
        "publication_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "MIGRATED_V1",
            "DIRECT_CHECK"
          ]
        },
        "author_configuration_terminations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/configuration_termination_statement"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "author_case_termination": {
          "$ref": "#/$defs/termination_statement"
        }
      },
      "required": [
        "id",
        "kind",
        "actor",
        "location",
        "checked_at",
        "summary",
        "origin"
      ],
      "additionalProperties": false
    },
