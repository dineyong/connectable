{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connectable.invalid/schemas/content-review.schema.json",
  "title": "Withheld content review ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "public_status",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "public_status": {
      "type": "string",
      "enum": [
        "UNKNOWN"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target_fact_id",
          "target_sha256",
          "reviewer_id",
          "reviewed_on",
          "notes",
          "result",
          "source_refs",
          "public_status",
          "usable_for_compatibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target_fact_id": {
            "type": "string",
            "minLength": 1
          },
          "target_sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "reviewer_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^reviewer:[a-z0-9-]+$"
          },
          "reviewed_on": {
            "type": "string",
            "minLength": 1,
            "format": "date"
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "NEEDS_REVIEW",
              "PARTIALLY_VERIFIED",
              "EVIDENCE_SUFFICIENT",
              "REJECTED"
            ]
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "public_status": {
            "type": "string",
            "enum": [
              "UNKNOWN"
            ]
          },
          "usable_for_compatibility": {
            "type": "string",
            "enum": [
              "NO"
            ]
          }
        }
      }
    }
  }
}
